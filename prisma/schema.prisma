generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin
  user
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
}

model Product {
  id           Int      @id @default(autoincrement())
  title        String   @unique
  description  String
  price        Float
  createdAt    DateTime @default(now())
}